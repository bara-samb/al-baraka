# En-têtes HTTP appliqués par Cloudflare Pages (ignorés en local).

# Fichiers aux noms hachés : immuables, mis en cache un an.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Toujours revalidés, pour que les mises à jour de l'app arrivent tout de suite.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
