{
  "name": "al-baraka-mobile",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start -c --offline",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:web": "node scripts/check-audio-env.js && npx expo export -p web --clear",
    "serve:web": "npx expo serve",
    "deploy:web": "npm run build:web && wrangler deploy",
    "audio:upload": "python ../backend/scripts/upload-audio-archive.py"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^57.0.6",
    "expo-file-system": "~19.0.23",
    "expo-font": "^57.0.1",
    "expo-haptics": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.149.0"
  },
  "private": true
}
